# -------------------------------------------------------------------
# Configuration Globale - Studio Photography Platform
# -------------------------------------------------------------------

# Application
APP_NAME="Studio Photo Pro"
APP_ENV=local
APP_KEY=change-me-generate-a-random-key
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sécurité backend (FastAPI)
# ENVIRONMENT=development   # development | production
# JWT_SECRET_KEY=             # ≥32 caractères en production (openssl rand -hex 32)
# SUPERUSER_EMAIL=root@kswstudio.internal
# SUPERUSER_PASSWORD=         # ≥16 caractères en production — jamais de valeur par défaut
# CORS_ALLOWED_ORIGINS=https://votre-domaine.fr,https://www.votre-domaine.fr
# MAX_UPLOAD_BYTES=26214400   # 25 Mo — uploads admin
# MAX_GUEST_UPLOAD_BYTES=8388608
# ALLOW_DEMO_SEED=false       # true uniquement pour re-seeder des données de démo en prod

# PostgreSQL Database (local Docker — optionnel si DATABASE_URL Supabase est défini)
POSTGRES_DB=studio_photo
POSTGRES_USER=studio_user
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=postgres
DB_PORT=5432

# Supabase (remplace postgres local en prod / cloud)
# Dashboard → Project Settings → Database → Connection string → URI
# Pooler « Transaction » (port 6543) recommandé pour FastAPI / SQLAlchemy
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_SSLMODE=require

# Supabase Storage — photos / médias cloud
# SUPABASE_URL=https://[project-ref].supabase.co
# STORAGE_BACKEND=supabase
# SUPABASE_SERVICE_ROLE_KEY=   # Dashboard → Settings → API → service_role (≠ mot de passe DB)
# SUPABASE_STORAGE_BUCKET=gallery-media
# STORAGE_LOCAL_MIRROR=false   # true = copie locale en plus du cloud

# Redis Cache & Queues
REDIS_HOST=redis
REDIS_PORT=6379

# Stripe Payment Gateway
STRIPE_KEY=pk_test_sample
STRIPE_SECRET=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample

# Mailtrap — envoi réel (optionnel)
# MAILTRAP_API_TOKEN=

# Gmail SMTP / API (optionnel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_FROM=
# GMAIL_APP_PASSWORD=
# GMAIL_USE_API=true
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
